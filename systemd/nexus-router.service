[Unit]
Description=Nexus Router HTTP server
After=network.target

[Service]
EnvironmentFile=/etc/ghabs/env
Type=simple
User=ubuntu
WorkingDirectory=${NEXUS_ROUTER_SRC:-/home/ubuntu/git/ghabs/nexus-router}
ExecStart=${NEXUS_ROUTER_SRC:-/home/ubuntu/git/ghabs/nexus-router}/venv/bin/python -m src.server --port 7771
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-router

[Install]
WantedBy=multi-user.target
